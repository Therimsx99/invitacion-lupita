---
import Base from '../layouts/Base.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Te invitamos a los 75 años de Lupita" music={false}>
  <main class="relative z-[3] min-h-dvh flex flex-col items-center justify-center px-8 py-24 text-center">
    <p class="caps text-[.85rem] text-brown">Ups…</p>
    <p class="num font-medium leading-none text-[#8c6b55] text-[7rem] my-2">404</p>
    <p class="font-script text-[3rem] leading-tight text-ink">No encontramos tu invitación</p>
    <div class="orn w-full my-6"><span class="text-[.7rem]">✦</span></div>
    <p class="text-[1.25rem] text-ink max-w-[320px]">
      Revisa que el enlace que recibiste esté completo, o pide que te lo envíen de nuevo.
    </p>
    <a class="btn mt-8" href={`${b}/`}>Ver la invitación</a>
  </main>
</Base>
