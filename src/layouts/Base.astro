---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  gate?: boolean;
  music?: boolean;
}
const {
  title = 'Te invitamos a los 75 años de Lupita',
  description = 'Sábado 12 de diciembre de 2026 · Misa 6:00 PM · Recepción 7:00 PM · Puebla',
  gate = false,
  music = true,
} = Astro.props;

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = Astro.site!.origin;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = `${origin}${b}/og.jpg`;
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#F7F2E6" />
    <link rel="icon" type="image/svg+xml" href={`${b}/favicon.svg`} />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline define:vars={{ gate }}>
      document.documentElement.classList.add('js');
      if (gate) document.documentElement.classList.add('has-gate');
    </script>
    <style is:global>
      html:not(.has-gate) #gate { display: none !important; }
    </style>
  </head>
  <body class:list={[{ locked: gate }]} data-gate={gate ? '1' : '0'}>
    <slot name="gate" />

    <div id="petals" aria-hidden="true" class="fixed inset-0 z-0 pointer-events-none overflow-hidden"></div>

    <div class="relative z-[1] mx-auto w-full max-w-[520px] min-h-dvh overflow-hidden">
      <div class="frame"></div>
      <img data-sway src={`${b}/flor-sup-izq.png`} alt="" width="448" height="559"
        class="absolute top-0 left-0 w-[46%] max-w-[240px] h-auto z-[1] pointer-events-none select-none origin-top-left" />
      <slot />
      <img data-sway src={`${b}/flor-inf-der.png`} alt="" width="322" height="464"
        class="absolute bottom-0 right-0 w-[36%] max-w-[190px] h-auto z-[1] pointer-events-none select-none origin-bottom-right" />
    </div>

    {music && (
      <>
        <audio id="bgm" src={`${b}/musica.mp3`} preload="metadata" loop></audio>
        <button id="music" type="button" hidden aria-label="Reproducir música" aria-pressed="false"
          class="fixed bottom-4 left-4 z-40 h-12 w-12 rounded-full bg-btn text-paper grid place-items-center shadow-lg active:scale-95 transition-transform">
          <svg class="icon-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          <svg class="icon-pause hidden" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
        </button>
      </>
    )}

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
